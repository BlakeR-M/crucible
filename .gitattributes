# Normalise line endings in the repository to LF; check out LF everywhere.
* text=auto eol=lf

# PowerShell reads CRLF most happily.
*.ps1 text eol=crlf

# Binaries: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary
*.pdf binary
