# Never. The arena reads a key from the environment on the host.
.env
*.env
!demo_target/**

# Run ledgers are written at runtime and are per-deployment.
runs/*.jsonl

# Scratch the agents are permitted to write into.
demo_target/.crucible-scratch/

__pycache__/
*.pyc
.venv/
.DS_Store
Thumbs.db

# Benchmark ledgers for runs still in progress. The completed arm-X.json
# carries every reply anyway, so a half-written run adds nothing.
bench/results/*-run*.jsonl
